# --- DATABASE CONFIG ---
# Direct connection to Vercel/Neon/AWS Postgres
# Format: postgresql://[user]:[password]@[host]:5432/[dbname]?sslmode=require
DATABASE_URL="postgresql://user:password@host:5432/db"

# --- BACKEND SECURITY ---
# A 32+ character random string to secure your /api/stats and /webhook routes
# Generated: openssl rand -base64 32
API_KEY="stx_live_55a9b8..."

# --- STACKS NETWORK ---
# Options: mainnet, testnet, devnet
NETWORK="mainnet"

# --- HIRO PLATFORM (CHAINHOOKS V2) ---
# New v2 Base URL for 2026 deployments
HIRO_API_BASE_URL="https://api.mainnet.hiro.so"

# Your Hiro Platform API Key (Found at platform.hiro.so)
HIRO_API_KEY="your-hiro-platform-secret-key"

# --- APP SETTINGS ---
PORT=3000
NODE_ENV="production"
